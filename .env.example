# ===== Primary AI — ZAI (智谱 AI) =====
# GLM-5.1 via OpenAI-compatible protocol. Used by Workshop, RAG, Hermes Gateway backend.
ZAI_API_KEY="your-zai-api-key"
ZAI_BASE_URL="https://api.z.ai/api/coding/paas/v4"

# ===== MiniMax API =====
# VLM image description (fallback for vision), NOT the primary chat model.
MINIMAX_API_KEY="your-minimax-api-key"
MINIMAX_BASE_URL="https://api.minimaxi.com/anthropic"
MINIMAX_VLM_URL="https://api.minimax.chat/v1/coding_plan/vlm"

# ===== ZCHAT API (multimodal fallback) =====
# Vision + text. Models: gpt-5, claude-sonnet-4-5, grok-3, grok-4, gemini-3-pro
ZCHAT_API_KEY="your-zchat-api-key"
ZCHAT_BASE_URL="https://api.zchat.tech/v1"
ZCHAT_VISION_MODEL="claude-sonnet-4-5"

# ===== DeepSeek API (final fallback) =====
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ===== Hermes Gateway =====
