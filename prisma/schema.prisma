generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                    @id @default(cuid())
  email             String                    @unique
  name              String?
  avatar            String?
  bio               String?
  role              UserRole                  @default(USER)
  emailVerified     DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  passwordHash      String?
  academicProfile   Json?                     @db.Json
  accounts          Account[]
  comments          Comment[]
  citations         CommunityCitation[]       @relation("CitationUser")
  verifiedCitations CommunityCitation[]       @relation("CitationVerifier")
  groups            GroupMember[]
  messages          Message[]
  posts             Post[]
  sessions          Session[]
  hostedRooms       TeaPartyRoom[]            @relation("RoomHost")
  teaPartyRooms     TeaPartyRoomParticipant[]
  topTenVotes       TopTenVote[]
  votes             Vote[]
  workshopSessions  WorkshopSession[]
  followedGroups    ResearchGroup[]           @relation("UserFollows")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Institution {
  id        String          @id @default(cuid())
  name      String          @unique
  logo      String?
  website   String?
  createdAt DateTime        @default(now())
  colleges  College[]
  groups    ResearchGroup[]
}

model College {
  id            String          @id @default(cuid())
  name          String
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departments   Department[]
  groups        ResearchGroup[]
}

model Department {
  id        String          @id @default(cuid())
  name      String
  collegeId String
  college   College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  groups    ResearchGroup[]
}

model ResearchGroup {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  logo               String?
  banner             String?
  description        String?
  institutionId      String
  collegeId          String?
  departmentId       String?
  score              Int                 @default(0)
  rank               Int?
  verificationStatus VerificationStatus  @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  citations          CommunityCitation[]
  disciplines        GroupDiscipline[]
  members            GroupMember[]
  news               News[]
  patents            Patent[]
  posts              Post[]
  publications       Publication[]
  college            College?            @relation(fields: [collegeId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  institution        Institution         @relation(fields: [institutionId], references: [id])
  scoreHistory       ScoreHistory[]
  followers          User[]              @relation("UserFollows")
}

model GroupMember {
  id       String        @id @default(cuid())
  userId   String
  groupId  String
  role     MemberRole    @default(MEMBER)
  joinedAt DateTime      @default(now())
  group    ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model ScoreHistory {
  id         String        @id @default(cuid())
  groupId    String
  score      Int
  recordedAt DateTime      @default(now())
  group      ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Discipline {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  parentId    String?
  level       Int               @default(0)
  parent      Discipline?       @relation("DisciplineTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Discipline[]      @relation("DisciplineTree")
  groups      GroupDiscipline[]
  posts       Post[]
}

model GroupDiscipline {
  id           String        @id @default(cuid())
  groupId      String
  disciplineId String
  discipline   Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  group        ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, disciplineId])
}

model Post {
  id                 String              @id @default(cuid())
  title              String
  content            String
  authorId           String
  disciplineId       String?
  isPinned           Boolean             @default(false)
  isLocked           Boolean             @default(false)
  viewCount          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  topTenVotes        Int                 @default(0)
  groupId            String?
  comments           Comment[]
  citations          CommunityCitation[] @relation("PostCitations")
  author             User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discipline         Discipline?         @relation(fields: [disciplineId], references: [id])
  group              ResearchGroup?      @relation(fields: [groupId], references: [id])
  linkedPublications PostPublication[]
  tags               PostTag[]
  topTenVoteRecords  TopTenVote[]
  votes              Vote[]
}

model Comment {
  id        String              @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  isPinned  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?            @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[]           @relation("CommentTree")
  post      Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  citations CommunityCitation[] @relation("CommentCitations")
  votes     Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  value     Int
  createdAt DateTime @default(now())
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model TopTenVote {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Publication {
  id                 String              @id @default(cuid())
  title              String
  abstract           String?
  authors            String[]
  year               Int?
  doi                String?             @unique
  url                String?
  pdfUrl             String?
  semanticScholarId  String?             @unique
  citationCount      Int                 @default(0)
  externalIds        String?
  groupId            String
  summary            String?
  summaryUpdatedAt   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  citedCitations     Citation[]          @relation("Cited")
  citingCitations    Citation[]          @relation("Citing")
  communityCitations CommunityCitation[] @relation("PublicationCitations")
  linkedPosts        PostPublication[]
  group              ResearchGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Citation {
  id                  String      @id @default(cuid())
  citedPublicationId  String
  citingPublicationId String
  citedPublication    Publication @relation("Cited", fields: [citedPublicationId], references: [id], onDelete: Cascade)
  citingPublication   Publication @relation("Citing", fields: [citingPublicationId], references: [id], onDelete: Cascade)

  @@unique([citedPublicationId, citingPublicationId])
}

model News {
  id         String        @id @default(cuid())
  title      String
  content    String   @db.Text
  coverImage String?
  groupId    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  group      ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Patent {
  id         String        @id @default(cuid())
  title      String
  number     String?
  status     String?
  filingDate DateTime?
  groupId    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  group      ResearchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model PostPublication {
  postId        String
  publicationId String
  post          Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@id([postId, publicationId])
}

model CommunityCitation {
  id              String         @id @default(cuid())
  citingUserId    String
  citingPostId    String?
  citingCommentId String?
  publicationId   String
  groupId         String
  context         String?
  status          CitationStatus @default(PENDING)
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionNote   String?
  createdAt       DateTime       @default(now())
  citingComment   Comment?       @relation("CommentCitations", fields: [citingCommentId], references: [id])
  citingPost      Post?          @relation("PostCitations", fields: [citingPostId], references: [id])
  citingUser      User           @relation("CitationUser", fields: [citingUserId], references: [id])
  group           ResearchGroup  @relation(fields: [groupId], references: [id])
  publication     Publication    @relation("PublicationCitations", fields: [publicationId], references: [id])
  verifier        User?          @relation("CitationVerifier", fields: [verifiedBy], references: [id])

  @@index([publicationId])
  @@index([groupId])
  @@index([citingUserId])
  @@index([status])
}

model TeaPartyRoom {
  id              String                    @id @default(cuid())
  name            String
  description     String?
  isPublic        Boolean                   @default(true)
  hostId          String
  maxParticipants Int                       @default(50)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        Message[]
  host            User                      @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants    TeaPartyRoomParticipant[]
}

model TeaPartyRoomParticipant {
  id       String       @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime     @default(now())
  room     TeaPartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Message {
  id        String       @id @default(cuid())
  content   String
  type      MessageType  @default(TEXT)
  roomId    String
  userId    String
  createdAt DateTime     @default(now())
  room      TeaPartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TopQuestion {
  id        String         @id @default(cuid())
  title     String
  content   String?
  month     String
  status    QuestionStatus @default(ACTIVE)
  voteCount Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  votes     QuestionVote[]
}

model QuestionVote {
  id         String      @id @default(cuid())
  questionId String
  userId     String
  value      Int
  question   TopQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

model WorkshopSession {
  id        String            @id @default(cuid())
  userId    String
  title     String            @default("新对话")
  mode      String            @default("general")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  WorkshopMessage[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

model WorkshopMessage {
  id          String          @id @default(cuid())
  sessionId   String
  role        String
  content     String
  citations   String?
  ragContext  String?
  attachments String?
  createdAt   DateTime        @default(now())
  session     WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model KnowledgeDocument {
  id         String                 @id @default(cuid())
  title      String
  content    String   @db.Text
  source     String?
  sourceId   String?
  discipline String?
  authorId   String?
  metadata   String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  viewCount  Int                    @default(0)
  embedding  Unsupported("vector")?

  @@index([discipline])
  @@index([source])
  @@index([updatedAt])
  @@index([authorId])
}

model KnowledgeBookmark {
  id        String   @id @default(cuid())
  userId    String
  docId     String
  createdAt DateTime @default(now())

  @@unique([userId, docId])
  @@index([userId])
  @@index([docId])
}

model PersonalDocument {
  id         String   @id @default(cuid())
  userId     String
  title      String
  authors    String?
  year       Int?
  journal    String?
  doi        String?
  url        String?
  fileSize   Int?
  pageCount  Int?
  chunkCount Int      @default(0)
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model ResearchMemory {
  id           String                 @id @default(cuid())
  type         MemoryType
  title        String
  content      String
  summary      String?
  discipline   String?
  userId       String?
  relatedPaper String?
  tags         String[]
  metadata     String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  embedding    Unsupported("vector")?

  @@index([type])
  @@index([discipline])
  @@index([userId])
  @@index([updatedAt])
}

enum UserRole {
  USER
  GROUP_ADMIN
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MemberRole {
  LEADER
  ADVISOR
  MEMBER
}

enum CitationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  STICKER
}

enum QuestionStatus {
  ACTIVE
  CLOSED
  SOLVED
}

enum MemoryType {
  IDEA
  PAPER_SUMMARY
  DISCUSSION
  QUESTION
  NOTES
}
